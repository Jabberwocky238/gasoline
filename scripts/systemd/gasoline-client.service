[Unit]
Description=Gasoline Client
Documentation=https://github.com/jabberwocky238/gasoline
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/gasoline/client.env
ExecStart=/usr/local/bin/gasoline client -c /etc/gasoline/client.yaml
Restart=on-failure
RestartSec=5s
LimitNOFILE=1048576

# Client creates a TUN device, needs CAP_NET_ADMIN
# Runs as root by default because /dev/net/tun + route table edits require it.
User=root
Group=root
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/log/gasoline /var/lib/gasoline
DeviceAllow=/dev/net/tun rw

StandardOutput=append:/var/log/gasoline/client.log
StandardError=append:/var/log/gasoline/client.log

[Install]
WantedBy=multi-user.target
